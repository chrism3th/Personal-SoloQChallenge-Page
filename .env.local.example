# Supabase — desde el dashboard del proyecto (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Secreto compartido para autorizar las rutas /api/cron/* (Vercel Cron
# envía este mismo valor en el header Authorization: Bearer <valor>).
CRON_SECRET=genera-un-valor-random-largo

# Email del admin de arranque: al registrarte en /registro con este email
# (mientras todavía no exista ningún admin) te salteás el código de
# invitación y quedás admin desde el alta — así se configura el sitio recién
# desplegado sin tocar SQL a mano. Deja de tener efecto en cuanto exista un
# primer admin, así que no queda como puerta trasera permanente. Opcional:
# si no la seteás, el primer admin se sigue creando a mano como antes.
ADMIN_EMAIL=tu-email@ejemplo.com

# La Riot API key NO va aquí — se configura desde /admin/api-key una vez
# el sitio está corriendo, y se guarda en la tabla app_settings, así se
# puede actualizar cada 24h (Personal Key) sin redeploy.
